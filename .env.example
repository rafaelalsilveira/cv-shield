GROQ_API_KEY=your_api_key_here

# Quando a IA revisa o currículo:
#   findings_only (padrão): só quando os detectores locais acham algo.
#   always: sempre. Pega manipulação parafraseada, mas envia o texto de todo
#           currículo para a API (cota e LGPD: veja o README).
AI_REVIEW_MODE=findings_only
